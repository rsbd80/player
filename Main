                <div class="bar"></div>
            </div>
        </div>
        <div id="player"></div>
    </div>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const streamSource = urlParams.get('url');

        if (streamSource) {
            const isDesktop = !/Mobi|Android|iPhone|iPad/i.test(navigator.userAgent);

            const player = jwplayer("player").setup({
                playlist: [{
                    file: streamSource,
                    type: "hls"
                }],
                width: "100%",
                height: "100%",
                autostart: true,
                stretching: "exactfit",
                skin: { name: "glow" },
                displaytitle: false,
                controls: true,
                mute: false,
                volume: 100
            });

            player.on("ready", () => {
                player.setMute(false);
                player.setVolume(100);
                console.log('✅ Player ready');
            });

            player.on("play", () => {
                document.getElementById("loader").classList.add("hide-now");
                console.log('▶️ Playing');
            });

            player.on("buffer", () => {
                document.getElementById("loader").classList.remove("hide-now");
                console.log('⏳ Buffering...');
            });

            player.on("error", (error) => {
                const loader = document.getElementById("loader");
                loader.classList.remove("hide-now");
                
                if (isDesktop) {
                    loader.innerHTML = `
                        <div class="error-content desktop-error">
                            <i class="fas fa-desktop"></i>
                            <p>⚠️ Stream may not be available on desktop.</p>
                            <p style="font-size:14px;color:#94a3b8;margin-top:5px;">Please try on mobile device.</p>
                            <div class="brand-name" style="margin-top:15px;">RS LIVE <span>TV</span></div>
                            <p style="font-size:11px;color:#64748b;margin-top:10px;">Error: ${error.message || 'Unknown error'}</p>
                        </div>
                    `;
                } else {
                    loader.innerHTML = `
                        <div class="error-content">
                            <i class="fas fa-exclamation-triangle"></i>
                            <p style="color:#94a3b8;font-size:13px;">Stream Offline</p>
                            <div class="brand-name">RS LIVE <span>TV</span></div>
                        </div>
                    `;
                }
                console.error('❌ Player error:', error);
            });

        } else {
            document.getElementById("loader").innerHTML = `
                <div class="error-content">
                    <i class="fas fa-link"></i>
                    <p style="color:#94a3b8;font-size:13px;">No Stream URL Found</p>
                    <div class="brand-name">RS LIVE <span>TV</span></div>
                </div>
            `;
        }
    </script>

</body>
